# =============================================================
# TaskQuest App — Environment Variables
# =============================================================
# Safe to commit — no secrets here.
# Secret values must go in .env.local (git-ignored).
# =============================================================

# ---- App ----
NODE_ENV=development
PORT=5000

# ---- App metadata ----
VITE_APP_NAME="TaskQuest"
VITE_APP_VERSION="1.0.0"

# ---- Public base URL (update after first Vercel deploy) ----
VITE_APP_BASE_URL="https://your-project.vercel.app"
API_BASE_URL="https://your-backend.vercel.app/api/v1"

# ---- Feature flags ----
VITE_ENABLE_NOTIFICATIONS="true"
VITE_ENABLE_GAMIFICATION="true"

# ---- CORS: comma-separated allowed origins ----
# Example: https://your-project.vercel.app,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500
