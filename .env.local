# =============================================================
# TaskQuest App — LOCAL Environment Variables
# =============================================================
# ⚠️  NEVER commit this file to Git — it is in .gitignore.
# This file overrides .env for local development.
# For Vercel production, set these in the Vercel Dashboard.
# =============================================================

NODE_ENV=development
PORT=5000

# ---- MongoDB ----
# Local Atlas / MongoDB URI — replace with your connection string
MONGODB_URI=mongodb://127.0.0.1:27017/taskquest

# Test DB (used by Jest)
MONGODB_TEST_URI=mongodb://127.0.0.1:27017/taskquest_test

# ---- JWT Secrets ----
# Generate strong secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_STRONG_64_CHAR_RANDOM_STRING
JWT_REFRESH_SECRET=REPLACE_WITH_A_DIFFERENT_STRONG_64_CHAR_STRING

# ---- CORS ----
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500

# ---- Local frontend URL ----
VITE_APP_BASE_URL=http://localhost:5500
API_BASE_URL=http://localhost:5000/api/v1
